<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>posternung</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- The SIT flavor's API base URL (lib/core/config/api_base_url_resolver.dart)
	     is a local-network http:// address for hitting posternung-backend on
	     the developer's machine — ATS blocks plain HTTP by default.
	     NSAllowsLocalNetworking scopes the exception to local-network
	     destinations only (not arbitrary HTTP everywhere), and is shared
	     across all three flavors since Info.plist isn't per-flavor here;
	     harmless on uat/production since neither talks to a local backend. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Required since iOS 14 whenever the app can reach local-network
	     destinations (posternung-backend on the developer's LAN during SIT
	     testing) — shown in the OS's local-network-access permission prompt. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>PosterNung ต่อกับเซิร์ฟเวอร์ทดสอบบนเครือข่ายเดียวกันระหว่างการพัฒนา</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<!-- Redirect target for Firebase Phone Auth's reCAPTCHA-verification
			     fallback (used when APNs silent verification isn't configured). -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<!-- The reCAPTCHA redirect above is auth plumbing, not app navigation —
	     firebase_auth's scene-delegate handling already consumes it
	     (canHandleURL:). This app also has no route table at all
	     (MaterialApp only sets home:, see lib/main.dart), so left at the
	     Flutter default, the engine ALSO pushes that same URL to the
	     framework as a route name, and _WidgetsAppState logs "Could not
	     find a generator for route /link?deep_link_id=...=verifyApp&...".
	     Harmless (auth still completes) but pure noise. False here opts
	     out of that second path only; if real deep/universal links are
	     ever added, remove this and add onGenerateRoute (or move to
	     MaterialApp.router) first. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
